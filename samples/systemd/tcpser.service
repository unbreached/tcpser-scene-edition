[Unit]
Description=TCPSER TCP-to-Serial Bridge (hardened)
Documentation=man:tcpser(1)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/usr/local/bin/tcpser check --config /etc/tcpser/tcpser.conf
ExecStart=/usr/local/bin/tcpser --config /etc/tcpser/tcpser.conf
ExecReload=/bin/kill -HUP $MAINPID
Environment=TCPSER_BLOCKLIST=/var/lib/tcpser/tcpser.blocklist
# Dashboard token etc. (mode 0640 root:tcpser): TCPSER_DASH_TOKEN=...
EnvironmentFile=-/etc/tcpser/tcpser.env
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=always
RestartSec=5
User=tcpser
Group=tcpser
SupplementaryGroups=dialout
LogsDirectory=tcpser
StateDirectory=tcpser

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RemoveIPC=yes
PrivateTmp=yes
PrivateDevices=no
DeviceAllow=/dev/ttyUSB0 rw
DeviceAllow=/dev/null rw
DevicePolicy=closed
ReadOnlyPaths=/usr/local/share/tcpser
ReadOnlyPaths=-/usr/local/tcpser/scripts
SystemCallFilter=@system-service
SystemCallFilter=~@debug @mount @module @obsolete @reboot @swap
SystemCallErrorNumber=EPERM
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
# Ports >= 1024 need no capability; drop everything.
CapabilityBoundingSet=
SeccompArchitectures=native

[Install]
WantedBy=multi-user.target
