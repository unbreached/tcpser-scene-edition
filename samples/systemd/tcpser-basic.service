[Unit]
Description=TCPSER TCP-to-Serial Bridge (Basic Configuration)
Documentation=man:tcpser(1)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Options in /etc/tcpser/tcpser.conf (template: tcpser help config)
ExecStartPre=/usr/local/bin/tcpser check --config /etc/tcpser/tcpser.conf
ExecStart=/usr/local/bin/tcpser --config /etc/tcpser/tcpser.conf
Environment=TCPSER_BLOCKLIST=/var/lib/tcpser/tcpser.blocklist
User=tcpser
Group=tcpser
SupplementaryGroups=dialout
LogsDirectory=tcpser
StateDirectory=tcpser
Restart=always
RestartSec=5

# Basic security
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
