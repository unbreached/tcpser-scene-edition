#!/bin/bash
# Sample gate success script - Enhanced logging
# Place in /usr/local/tcpser/scripts/
# Make executable: chmod +x gate_success_log

# Security: Basic input validation
if [[ ! "$1" =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]]; then
    echo "Invalid IP address format" >&2
    exit 1
fi

CLIENT_IP="$1"
TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S')
LOGFILE="/var/log/tcpser/gate_success.log"

# Ensure log directory exists
mkdir -p "$(dirname "$LOGFILE")"

# Log the successful gate pass
echo "[$TIMESTAMP] SUCCESS: Gate passed for IP $CLIENT_IP" >> "$LOGFILE"

# Optional: Send to syslog
logger -t tcpser "Gate success from $CLIENT_IP"

exit 0