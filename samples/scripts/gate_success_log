#!/bin/bash
# Sample gate success script - Enhanced logging
# Place in /usr/local/tcpser/scripts/ and make executable (chmod 755).
#
# How tcpser calls hooks: NO positional arguments. The caller's IP arrives in
# the environment variable TCPSER_PEER_IP (set by tcpser, always a dotted
# quad from inet_ntoa). PATH is reset to /usr/local/bin:/usr/bin:/bin.
# The hook runs detached; tcpser kills it after 30 s.
set -u
umask 077   # logs contain caller IPs (PII): not world-readable

CLIENT_IP="${TCPSER_PEER_IP:-}"
if [[ ! "$CLIENT_IP" =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]]; then
    echo "gate_success_log: TCPSER_PEER_IP missing or malformed" >&2
    exit 1
fi

TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S')
LOGFILE="${TCPSER_LOG_DIR:-/var/log/tcpser}/gate_success.log"

mkdir -p "$(dirname "$LOGFILE")" 2>/dev/null || true
echo "[$TIMESTAMP] SUCCESS: Gate passed for IP $CLIENT_IP" >> "$LOGFILE"

# Optional: syslog
logger -t tcpser "Gate success from $CLIENT_IP" 2>/dev/null || true

exit 0
