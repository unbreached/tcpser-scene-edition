#!/bin/bash
# Sample gate failure script - Security response
# Place in /usr/local/tcpser/scripts/
# Make executable: chmod +x gate_fail_security

# Security: Basic input validation
if [[ ! "$1" =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]]; then
    echo "Invalid IP address format" >&2
    exit 1
fi

CLIENT_IP="$1"
TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S')

# Configuration
FAIL_LOG="/var/log/tcpser/gate_failures.log"
TEMP_BAN_FILE="/tmp/tcpser_banned_ips"
MAX_FAILURES=5
BAN_DURATION=3600  # 1 hour in seconds

# Ensure log directory exists
mkdir -p "$(dirname "$FAIL_LOG")"

# Log the failure
echo "[$TIMESTAMP] FAIL: Gate failed for IP $CLIENT_IP" >> "$FAIL_LOG"
logger -t tcpser "Gate failure from $CLIENT_IP"

# Count recent failures from this IP (last hour)
RECENT_FAILURES=$(grep -c "$CLIENT_IP" <(tail -1000 "$FAIL_LOG" 2>/dev/null | grep "$(date -d '1 hour ago' '+%Y-%m-%d %H')\|$(date '+%Y-%m-%d %H')" || true))

# If too many failures, add to temporary ban list
if [[ "$RECENT_FAILURES" -ge "$MAX_FAILURES" ]]; then
    echo "[$TIMESTAMP] BANNED: $CLIENT_IP (failures: $RECENT_FAILURES)" >> "$FAIL_LOG"

    # Add to ban file with expiration
    EXPIRE_TIME=$(($(date +%s) + BAN_DURATION))
    echo "$CLIENT_IP $EXPIRE_TIME" >> "$TEMP_BAN_FILE"

    # Alert administrator
    logger -p user.warning -t tcpser "IP $CLIENT_IP temporarily banned after $RECENT_FAILURES failures"

    # Optional: Add to iptables (requires sudo access)
    # sudo iptables -I INPUT -s "$CLIENT_IP" -j DROP 2>/dev/null || true
fi

# Clean up expired bans
if [[ -f "$TEMP_BAN_FILE" ]]; then
    CURRENT_TIME=$(date +%s)
    while read -r IP EXPIRE_TIME; do
        if [[ "$EXPIRE_TIME" -gt "$CURRENT_TIME" ]]; then
            echo "$IP $EXPIRE_TIME"
        fi
    done < "$TEMP_BAN_FILE" > "${TEMP_BAN_FILE}.tmp"
    mv "${TEMP_BAN_FILE}.tmp" "$TEMP_BAN_FILE"
fi

exit 0