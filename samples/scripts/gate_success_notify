#!/bin/bash
# Sample gate success script - Notifications
# Place in /usr/local/tcpser/scripts/
# Make executable: chmod +x gate_success_notify

# Security: Basic input validation
if [[ ! "$1" =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]]; then
    echo "Invalid IP address format" >&2
    exit 1
fi

CLIENT_IP="$1"
TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S')

# Configuration - modify these as needed
WEBHOOK_URL="https://hooks.slack.com/services/YOUR/WEBHOOK/URL"
DISCORD_WEBHOOK=""
EMAIL_RECIPIENT="admin@example.com"

# Log the event
logger -t tcpser "Gate success from $CLIENT_IP"

# Send Slack notification (if webhook configured)
if [[ -n "$WEBHOOK_URL" && "$WEBHOOK_URL" != *"YOUR/WEBHOOK/URL"* ]]; then
    curl -X POST -H 'Content-type: application/json' \
        --data "{\"text\":\"🎉 TCPSER: New BBS connection from $CLIENT_IP at $TIMESTAMP\"}" \
        "$WEBHOOK_URL" 2>/dev/null &
fi

# Send email notification (requires mail command)
if command -v mail >/dev/null 2>&1 && [[ -n "$EMAIL_RECIPIENT" ]]; then
    echo "New BBS connection from $CLIENT_IP at $TIMESTAMP" | \
        mail -s "TCPSER: New Connection" "$EMAIL_RECIPIENT" 2>/dev/null &
fi

# Optional: Update statistics file
STATS_FILE="/var/log/tcpser/daily_stats.txt"
mkdir -p "$(dirname "$STATS_FILE")"
DATE=$(date '+%Y-%m-%d')
echo "$DATE $CLIENT_IP" >> "$STATS_FILE"

exit 0