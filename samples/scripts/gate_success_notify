#!/bin/bash
# Sample gate success script - Notifications (Slack / Discord / email)
# Place in /usr/local/tcpser/scripts/ and make executable (chmod 755).
#
# tcpser passes the caller IP in TCPSER_PEER_IP (no argv). PATH is fixed by
# tcpser. The hook is detached and killed after 30 s, so keep curl bounded.
set -u
umask 077

CLIENT_IP="${TCPSER_PEER_IP:-}"
if [[ ! "$CLIENT_IP" =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]]; then
    echo "gate_success_notify: TCPSER_PEER_IP missing or malformed" >&2
    exit 1
fi
TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S')

# Configuration - modify these as needed (or set them in /etc/tcpser/tcpser.env
# and pass that file to the service with EnvironmentFile=).
WEBHOOK_URL="${SLACK_WEBHOOK_URL:-}"
DISCORD_WEBHOOK="${DISCORD_WEBHOOK_URL:-}"
EMAIL_RECIPIENT="${TCPSER_NOTIFY_EMAIL:-}"

logger -t tcpser "Gate success from $CLIENT_IP" 2>/dev/null || true

# $CLIENT_IP is validated above (digits and dots only), so it is safe inside JSON.
if [[ -n "$WEBHOOK_URL" ]]; then
    curl -sS --max-time 10 -X POST -H 'Content-type: application/json' \
        --data "{\"text\":\"TCPSER: New BBS connection from $CLIENT_IP at $TIMESTAMP\"}" \
        "$WEBHOOK_URL" >/dev/null 2>&1 || true
fi
if [[ -n "$DISCORD_WEBHOOK" ]]; then
    curl -sS --max-time 10 -X POST -H 'Content-type: application/json' \
        --data "{\"content\":\"TCPSER: New BBS connection from $CLIENT_IP at $TIMESTAMP\"}" \
        "$DISCORD_WEBHOOK" >/dev/null 2>&1 || true
fi

if [[ -n "$EMAIL_RECIPIENT" ]] && command -v mail >/dev/null 2>&1; then
    echo "New BBS connection from $CLIENT_IP at $TIMESTAMP" | \
        mail -s "TCPSER: New Connection" "$EMAIL_RECIPIENT" 2>/dev/null || true
fi

# Optional: daily statistics file
STATS_FILE="${TCPSER_LOG_DIR:-/var/log/tcpser}/daily_stats.txt"
mkdir -p "$(dirname "$STATS_FILE")" 2>/dev/null || true
echo "$(date '+%Y-%m-%d') $CLIENT_IP" >> "$STATS_FILE"

exit 0
