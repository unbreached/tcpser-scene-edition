<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tcpser.bbs</string>

  <!-- All options live in /usr/local/etc/tcpser/tcpser.conf (template:
       /usr/local/share/tcpser/tcpser.conf, or `tcpser help config`).
       Validate after editing: tcpser check (same --config). -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/tcpser</string>
    <string>--config</string>
    <string>/usr/local/etc/tcpser/tcpser.conf</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/usr/local/share/tcpser</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <!-- Restart on crash, wait 5 seconds between attempts -->
  <key>ThrottleInterval</key>
  <integer>5</integer>

  <!-- tcpser writes its own log (log-file = ... in tcpser.conf); launchd only
       captures the startup banner and crashes here, so the two never
       interleave in one file. -->
  <key>StandardOutPath</key>
  <string>/var/log/tcpser-launchd.log</string>

  <key>StandardErrorPath</key>
  <string>/var/log/tcpser-launchd.log</string>

  <!--
    INSTALL:
      sudo cp com.tcpser.bbs.plist /Library/LaunchDaemons/
      sudo launchctl load /Library/LaunchDaemons/com.tcpser.bbs.plist

    UNINSTALL:
      sudo launchctl unload /Library/LaunchDaemons/com.tcpser.bbs.plist
      sudo rm /Library/LaunchDaemons/com.tcpser.bbs.plist

    SETUP:
      sudo mkdir -p /usr/local/etc/tcpser
      sudo cp /usr/local/share/tcpser/tcpser.conf /usr/local/etc/tcpser/
      edit it (device = /dev/cu.usbserial-*, speed, listen, gate, log-file,
      blocklist under a writable directory), then:
      tcpser check --config /usr/local/etc/tcpser/tcpser.conf
    Runs as root by default; for an unprivileged run add UserName/GroupName
    with a user in the dialout-equivalent group for the serial device.
  -->
</dict>
</plist>
